{
  "name": "hdu-profile-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "HDU // Personal Development System — the source system that generates the hakanduyar GitHub profile",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run data:snapshot && npm run render && npm run readme && npm run validate",
    "data:snapshot": "tsx scripts/generate/snapshot.ts",
    "render": "tsx scripts/render/render-all.ts",
    "readme": "tsx scripts/generate/readme.ts",
    "validate": "tsx scripts/validate/validate-all.ts",
    "qa:visual": "tsx scripts/validate/visual-qa.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^26.2.0",
    "@types/pngjs": "^6.0.5",
    "fast-xml-parser": "^5.11.0",
    "fontkit": "^2.0.4",
    "pngjs": "^7.0.0",
    "puppeteer-core": "^25.8.0",
    "svgo": "^4.0.2",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
